# codex api settings
# Copy this file to config.ini for local use.

codex.local.enable=false
codex.local.command_path=/usr/local/bin/codexp
codex.local.model_name=codex:local
codex.local.timeout_seconds=45
codex.local.debug=true
codex.local.bypass_approvals=true
codex.local.keep_session=true
codex.local.code_home_dir=/home/agarty/.codex

codex.api.enable=false
codex.api.api_key=
codex.api.base_url=https://api.openai.com/v1
codex.api.openai_model=gpt-5.5
codex.api.timeout_seconds=45

codex.api.proxy_enabled=false
codex.api.proxy_host=localhost
codex.api.proxy_port=9997
codex.api.proxy_username=
codex.api.proxy_password=
